---
import Base from "../layouts/Base.astro";
import { SITE_EMAIL, SOCIAL_MEDIA } from "../consts";
import Polaroid from "../components/Polaroid.astro";

const filepath = "./src/pages/index.astro";
---

<Base filepath={filepath}>
  <div class="container">
    <Polaroid />
    <div class="description">
      <br />
      Hey! 
      <br /><br />
      I recently graduated from Brown University, where I studied Computer Science and Mathematics. There, I was a TA for courses covering computer vision, data science, and cybersecurity. I'm passionate about peer education and the role TAs can play in fostering an inclusive learning environment.
      <br /><br />
      I'm currently in the process of moving to California 📍
    </div>
  </div>
  <hr />
  <div class="contact">
    <span>
      Please feel free to reach me at <a href={"mailto:" + SITE_EMAIL}
        >{SITE_EMAIL}</a
      > or on <a href={SOCIAL_MEDIA.linkedin}>linkedin</a>.
    </span>
  </div>
</Base>

<style>
  .description {
    text-wrap: wrap;
  }

  hr {
    margin: 1em;
  }
</style>
