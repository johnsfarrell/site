---
import Base from "../layouts/Base.astro";
import Book from "../components/Book.astro";
import { getCollection } from "astro:content";
import { BOOKS } from "../consts";

const filepath = "./src/pages/bookshelf.astro";

const blogs = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const articles = (await fetch(`https://opensheet.elk.sh/${import.meta.env.ARTICLES_GOOGLE_SHEET_ID}/Sheet1`).then(res => res.json())).filter(
  (article: any) => article.star
).reverse();
---

<Base filepath={filepath}>
  <div class="container">
    <div class="books">
      {BOOKS.map((book) => (
        <Book {...book} />
      ))}
    </div>
    <hr />
    <div class="columns">
      <section>
        <h4>More reads</h4>
        <ul>
          {
            articles.map((article: any) => (
              <li>
                  <img 
                    src={`https://www.google.com/s2/favicons?domain=${article.link}&sz=32`} 
                    alt={article.title + " favicon"} 
                    class="favicon"
                    loading="lazy"
                  />
                <a href={article.link} target="_blank">
                  {article.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h4>My writing</h4>
        <ul>
          {
            blogs.map((blog: any) => (
              <li>
                <a href={`/writing/${blog.id}/`}>
                  {blog.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .books {
    padding-top: 2em;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  ul {
    padding: 0;
  }
  
  li {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .favicon {
    width: 16px;
    height: 16px;
  }

  .columns {
    display: grid;
    grid-template-columns: 2fr 1fr;
  }

  @media (max-width: 800px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>